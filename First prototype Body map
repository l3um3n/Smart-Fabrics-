import plotly.graph_objects as go

fig = go.Figure()

fig.add_trace(go.Scatter3d(
    x=[0.4, 0.1,0.1,0.1, 0.4,0.4, 0.7,0.7,0.7],
    y=[0.5, 0.5,0.5,0.5, 0.5,0.5, 0.5,0.5,0.5],
    z=[0.8, 0.5,0.3,0.1, 0.5,0.1, 0.5,0.3,0.1],
    mode="markers+lines",
    marker=dict(size=6)
))

fig.update_layout(
    title="Basic 3D Scene",
    width=800,
    height=800,

    scene=dict(
        xaxis=dict(
            title="X",
            range=[-2, 2]
        ),
        yaxis=dict(
            title="Y",
            range=[0, 2]
        ),
        zaxis=dict(
            title="Z",
            range=[-2, 2]
        ),

        aspectmode="cube"
    )
)

fig.show()
